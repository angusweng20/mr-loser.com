---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { authorship as authorshipMap, site } from '../../site.config';
import {
  categoryLabel,
  categoryUrl,
  formatDateNumeric,
  getVisiblePosts,
  isPublished,
  type Post,
} from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getVisiblePosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: Post;
}
const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, image, imageAlt, draft, category, authorship } = post.data;
const author = authorshipMap[authorship];
const unpublished = draft || !isPublished(post);
const url = new URL(Astro.url.pathname, Astro.site).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: { '@type': 'Person', name: site.author, url: site.url },
  mainEntityOfPage: url,
  inLanguage: site.locale,
  articleSection: categoryLabel(category),
  digitalSourceType: author.schema,
  ...(image ? { image: new URL(image, Astro.site).toString() } : {}),
};
---

<Base
  title={title}
  description={description}
  type="article"
  image={image}
  imageAlt={imageAlt}
  publishedTime={pubDate}
  modifiedTime={updatedDate}
  noindex={unpublished}
  jsonLd={jsonLd}
>
  <article class="art">
    <aside class="art-rail">
      <a class="vmark" href={categoryUrl(category)}>{categoryLabel(category)}</a>
      <div class="row">
        <span class="k">刊出 / PUBLISHED</span>
        <time datetime={pubDate.toISOString()}>{formatDateNumeric(pubDate)}</time>
      </div>
      {updatedDate && (
        <div class="row">
          <span class="k">更新 / UPDATED</span>
          <time datetime={updatedDate.toISOString()}>{formatDateNumeric(updatedDate)}</time>
        </div>
      )}
      <div class="row zh">
        <span class="k">屬性 / SOURCE</span>
        {author.short}
      </div>
    </aside>

    <div class="art-main">
      <p class="art-kicker"><a href="/posts/">文章</a> — {categoryLabel(category)}</p>
      <h1>
        {title}
        {draft && <span class="badge">草稿</span>}
        {!draft && unpublished && <span class="badge">排程</span>}
      </h1>
      <p class="dek">{description}</p>

      {image && (
        <figure class="cover">
          <img src={image} alt={imageAlt ?? ''} width="1600" loading="eager" decoding="async" />
        </figure>
      )}

      <div class="article-body">
        <Content />
      </div>

      <div class="authorship" data-authorship={authorship}>
        <span class="k">作者屬性 / AUTHORSHIP</span>
        {author.label}
      </div>

      <footer class="article-footer">
        <p><a href="/posts/">← 所有文章</a></p>
      </footer>
    </div>
  </article>
</Base>
