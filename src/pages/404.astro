---
import Base from '../layouts/Base.astro';
---

<Base title="找不到頁面" noindex>
  <div class="pagehead">
    <div>
      <p class="kicker">404 — NOT FOUND</p>
      <h1>找不到這一頁</h1>
      <p class="lede">這個網址可能已經移動或不存在。</p>
    </div>
    <div class="vmark">走錯了</div>
  </div>

  <div class="actions">
    <a class="btn" href="/">回首頁</a>
    <a class="btn-2" href="/posts/">看所有文章</a>
  </div>
</Base>
