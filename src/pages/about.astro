---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { site } from '../site.config';

const entry = await getEntry('pages', 'about');
if (!entry) throw new Error('缺少 src/content/pages/about.md');
const { Content } = await render(entry);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.author,
  url: site.url,
  email: site.contactEmail,
};
---

<Base title={entry.data.title} description={entry.data.description} jsonLd={jsonLd}>
  <div class="pagehead">
    <div>
      <p class="kicker">ABOUT — 關於與合作</p>
      <h1>{entry.data.title}</h1>
      <p class="lede">{entry.data.description}</p>
    </div>
    <div class="vmark">{site.hero.vmark}</div>
  </div>

  <article class="article-body">
    <Content />
  </article>
</Base>
