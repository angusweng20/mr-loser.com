---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { site } from '../site.config';
import { getVisiblePosts, postUrl } from '../lib/posts';

const all = await getVisiblePosts();
const posts = all.slice(0, site.homePostCount);
const newest = all[0];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: site.url,
  description: site.tagline,
  author: { '@type': 'Person', name: site.author, url: site.url },
};
---

<Base jsonLd={jsonLd}>
  <section class="hero-grid">
    <div class="hero">
      <p class="kicker">{site.hero.kicker}</p>
      <h1>
        {site.hero.lead}<br /><span class="hl">{site.hero.highlight}</span>{site.hero.tail}
      </h1>
      {site.intro.map((p) => <p class="lede">{p}</p>)}
      <div class="actions">
        {newest && <a class="btn" href={postUrl(newest)}>讀最新一篇</a>}
        <a class="btn-2" href="/rss.xml">RSS 訂閱</a>
      </div>
    </div>
    <div class="vmark">{site.hero.vmark}</div>
  </section>

  <section>
    <div class="sec-head">
      <p class="lbl">最新文章<em>LATEST</em></p>
      <a class="more" href="/posts/">ALL POSTS →</a>
    </div>
    <PostList posts={posts} />
    {posts.length > 0 && <a class="all-link" href="/posts/">所有文章 →</a>}
  </section>
</Base>
