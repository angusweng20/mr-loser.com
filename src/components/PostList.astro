---
import { categoryLabel, categoryUrl, formatDate, isPublished, postUrl, type Post } from '../lib/posts';
interface Props {
  posts: Post[];
  /** 在分類頁本身不需要再顯示分類 */
  showCategory?: boolean;
}
const { posts, showCategory = true } = Astro.props;
const now = new Date();
---

{posts.length === 0 ? (
  <p class="muted">還沒有文章。</p>
) : (
  <ul class="post-list">
    {posts.map((p) => (
      <li>
        <a href={postUrl(p)}>{p.data.title}</a>
        {p.data.draft && <span class="badge">草稿</span>}
        {!p.data.draft && !isPublished(p, now) && <span class="badge">排程</span>}
        <p class="desc">{p.data.description}</p>
        <p class="post-meta">
          <time datetime={p.data.pubDate.toISOString()}>{formatDate(p.data.pubDate)}</time>
          {showCategory && (
            <>
              <span class="sep">·</span>
              <a class="cat" href={categoryUrl(p.data.category)}>{categoryLabel(p.data.category)}</a>
            </>
          )}
        </p>
      </li>
    ))}
  </ul>
)}
