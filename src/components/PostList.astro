---
import {
  categoryLabel,
  categoryUrl,
  formatDateNumeric,
  formatMonthDay,
  isPublished,
  postUrl,
  type Post,
} from '../lib/posts';
interface Props {
  posts: Post[];
  /** 在分類頁本身不需要再顯示分類 */
  showCategory?: boolean;
  /** 列表已經有年份分隔時，日期只留月日 */
  dateStyle?: 'full' | 'short';
}
const { posts, showCategory = true, dateStyle = 'full' } = Astro.props;
const showDate = dateStyle === 'short' ? formatMonthDay : formatDateNumeric;
const now = new Date();
---

{posts.length === 0 ? (
  <p class="muted">還沒有文章。</p>
) : (
  <ul class="post-list">
    {posts.map((p) => (
      <li>
        <div class="rail">
          <time class="date" datetime={p.data.pubDate.toISOString()}>{showDate(p.data.pubDate)}</time>
          {showCategory && (
            <a class="cat" href={categoryUrl(p.data.category)}>{categoryLabel(p.data.category)}</a>
          )}
        </div>
        <div>
          <h3 class="p-title">
            <a href={postUrl(p)}>{p.data.title}</a>
            {p.data.draft && <span class="badge">草稿</span>}
            {!p.data.draft && !isPublished(p, now) && <span class="badge">排程</span>}
          </h3>
          <p class="p-desc">{p.data.description}</p>
        </div>
      </li>
    ))}
  </ul>
)}
