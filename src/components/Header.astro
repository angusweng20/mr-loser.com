---
import { site } from '../site.config';
const path = Astro.url.pathname;
const nav = [
  { href: '/', label: '首頁' },
  { href: '/posts/', label: '文章' },
  { href: '/about/', label: '關於' },
];
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<div class="edge"></div>
<header class="site-header">
  <div class="wrap">
    <div class="masthead">
      <a class="brand" href="/">
        <span class="wordmark">{site.nameZh}</span>
        <span class="latin">{site.nameLatin}</span>
      </a>
      <nav aria-label="主選單">
        {nav.map((n) => (
          <a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a>
        ))}
        <a class="rss" href="/rss.xml">RSS</a>
      </nav>
    </div>
    <div class="rule-heavy"></div>
  </div>
</header>
