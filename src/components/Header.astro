---
import { site } from '../site.config';
const path = Astro.url.pathname;
const nav = [
  { href: '/', label: '首頁' },
  { href: '/posts/', label: '文章' },
  { href: '/about/', label: '關於' },
];
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/">{site.name}</a>
    <nav aria-label="主選單">
      {nav.map((n) => (
        <a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a>
      ))}
    </nav>
  </div>
</header>
